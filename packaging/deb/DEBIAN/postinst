#!/usr/bin/env bash
set -euo pipefail

INSTALL_DIR=/usr/lib/vhttechkey
IBUS_COMPONENT_DIR=/usr/share/ibus/component
FCITX5_IM_DIR=/usr/share/fcitx5/inputmethod

register_ibus() {
    if ! command -v ibus &>/dev/null; then
        return
    fi
    ibus restart 2>/dev/null || true

    # Đăng ký engine cho từng user đang đăng nhập
    while IFS= read -r uid; do
        local username
        username=$(id -un "$uid" 2>/dev/null) || continue
        local dbus_addr=""
        while IFS= read -r pid; do
            local addr
            addr=$(grep -z DBUS_SESSION_BUS_ADDRESS /proc/"$pid"/environ 2>/dev/null \
                   | tr -d '\0' | sed 's/DBUS_SESSION_BUS_ADDRESS=//' || true)
            if [[ -n "$addr" ]]; then
                dbus_addr="$addr"
                break
            fi
        done < <(pgrep -u "$uid" 2>/dev/null | head -20)

        [[ -z "$dbus_addr" ]] && continue

        local current
        current=$(sudo -u "$username" DBUS_SESSION_BUS_ADDRESS="$dbus_addr" \
            gsettings get org.freedesktop.ibus.general preload-engines 2>/dev/null \
            || echo "@as []")

        if [[ "$current" == *"vhttechkey"* ]]; then
            continue
        fi

        local new_list
        if [[ "$current" == "@as []" || "$current" == "[]" ]]; then
            new_list="['xkb:us::eng', 'vhttechkey']"
        else
            new_list="${current%]}, 'vhttechkey']"
        fi

        sudo -u "$username" DBUS_SESSION_BUS_ADDRESS="$dbus_addr" \
            gsettings set org.freedesktop.ibus.general preload-engines "$new_list" 2>/dev/null || true
        sudo -u "$username" DBUS_SESSION_BUS_ADDRESS="$dbus_addr" \
            gsettings set org.freedesktop.ibus.general engines-order "$new_list" 2>/dev/null || true
    done < <(loginctl list-users --no-legend 2>/dev/null | awk '{print $1}')
}

enable_service_for_users() {
    while IFS= read -r uid; do
        local username
        username=$(id -un "$uid" 2>/dev/null) || continue
        # Chạy systemctl --user enable --now trong session của user
        sudo -u "$username" \
            XDG_RUNTIME_DIR="/run/user/$uid" \
            DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
            systemctl --user enable --now vhttechkey-daemon 2>/dev/null || true
    done < <(loginctl list-users --no-legend 2>/dev/null | awk '{print $1}')
    # Reload để các user mới login cũng tự chạy
    systemctl daemon-reload 2>/dev/null || true
}

case "$1" in
    configure)
        update-desktop-database /usr/share/applications 2>/dev/null || true
        register_ibus
        enable_service_for_users

        echo ""
        echo "╔══════════════════════════════════════════════════════╗"
        echo "║       ✓ Cài đặt VHTTechKey thành công!              ║"
        echo "╠══════════════════════════════════════════════════════╣"
        echo "║  Vui lòng ĐĂNG XUẤT và ĐĂNG NHẬP LẠI để bắt đầu   ║"
        echo "║  gõ tiếng Việt.                                      ║"
        echo "║                                                      ║"
        echo "║  Phím tắt: Ctrl+Space để bật/tắt bộ gõ              ║"
        echo "╚══════════════════════════════════════════════════════╝"
        echo ""
        ;;
esac
