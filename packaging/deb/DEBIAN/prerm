#!/usr/bin/env bash
set -euo pipefail

stop_and_disable_service() {
    while IFS= read -r uid; do
        local username
        username=$(id -un "$uid" 2>/dev/null) || continue
        sudo -u "$username" \
            XDG_RUNTIME_DIR="/run/user/$uid" \
            DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
            systemctl --user disable --now vhttechkey-daemon 2>/dev/null || true
    done < <(loginctl list-users --no-legend 2>/dev/null | awk '{print $1}')
}

remove_ibus_engine() {
    if ! command -v ibus &>/dev/null; then
        return
    fi
    while IFS= read -r uid; do
        local username
        username=$(id -un "$uid" 2>/dev/null) || continue
        local dbus_addr=""
        while IFS= read -r pid; do
            local addr
            addr=$(grep -z DBUS_SESSION_BUS_ADDRESS /proc/"$pid"/environ 2>/dev/null \
                   | tr -d '\0' | sed 's/DBUS_SESSION_BUS_ADDRESS=//' || true)
            if [[ -n "$addr" ]]; then
                dbus_addr="$addr"
                break
            fi
        done < <(pgrep -u "$uid" 2>/dev/null | head -20)

        [[ -z "$dbus_addr" ]] && continue

        local current
        current=$(sudo -u "$username" DBUS_SESSION_BUS_ADDRESS="$dbus_addr" \
            gsettings get org.freedesktop.ibus.general preload-engines 2>/dev/null || echo "[]")

        local new_list
        new_list=$(echo "$current" | sed "s/, 'vhttechkey'//; s/'vhttechkey', //; s/'vhttechkey'//")

        sudo -u "$username" DBUS_SESSION_BUS_ADDRESS="$dbus_addr" \
            gsettings set org.freedesktop.ibus.general preload-engines "$new_list" 2>/dev/null || true
    done < <(loginctl list-users --no-legend 2>/dev/null | awk '{print $1}')
}

case "$1" in
    remove|purge)
        stop_and_disable_service
        remove_ibus_engine
        ibus restart 2>/dev/null || true
        ;;
esac
